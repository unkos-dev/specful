{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unkos-dev.github.io/specful/schemas/adr/v1.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "Specful ADR profile v1 frontmatter",
  "description": "Validates the loaded JSON-compatible value of Specful ADR v1 frontmatter.",
  "type": "object",
  "required": [
    "kind",
    "profile-version",
    "id",
    "title",
    "status",
    "recorded-on",
    "decision-makers"
  ],
  "properties": {
    "kind": {
      "const": "adr"
    },
    "profile-version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/adr-id"
    },
    "title": {
      "$ref": "#/$defs/core-text"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "deprecated",
        "superseded"
      ]
    },
    "recorded-on": {
      "$ref": "#/$defs/full-date"
    },
    "decided-on": {
      "$ref": "#/$defs/full-date"
    },
    "decision-makers": {
      "$ref": "#/$defs/participants"
    },
    "consulted": {
      "$ref": "#/$defs/participants"
    },
    "informed": {
      "$ref": "#/$defs/participants"
    },
    "supersedes": {
      "$ref": "#/$defs/adr-id-list"
    },
    "superseded-by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adr-id"
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "proposed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "decided-on"
              ]
            },
            {
              "required": [
                "supersedes"
              ]
            },
            {
              "required": [
                "superseded-by"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "deprecated"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "superseded-by"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded-by"
        ]
      }
    }
  ],
  "$defs": {
    "adr-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-ADR-[0-9]{4}$",
      "not": {
        "pattern": "-ADR-0000$"
      }
    },
    "adr-id-list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adr-id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "core-text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        {
          "not": {
            "pattern": "^\\s|\\s$"
          }
        }
      ]
    },
    "full-date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
      "format": "date"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/core-text"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
