{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unkos-dev.github.io/specful/schemas/config/v1.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "Specful repository configuration v1",
  "type": "object",
  "required": [
    "config-version",
    "project-key",
    "specful-version",
    "next-adr-sequence",
    "next-requirement-sequence",
    "next-design-sequence"
  ],
  "properties": {
    "config-version": { "const": 1 },
    "project-key": { "$ref": "#/$defs/project-key" },
    "specful-version": { "$ref": "#/$defs/specful-version" },
    "next-adr-sequence": { "$ref": "#/$defs/counter" },
    "next-requirement-sequence": { "$ref": "#/$defs/counter" },
    "next-design-sequence": { "$ref": "#/$defs/counter" }
  },
  "additionalProperties": false,
  "$defs": {
    "project-key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}$"
    },
    "specful-version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
