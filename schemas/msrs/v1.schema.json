{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unkos-dev.github.io/specful/schemas/msrs/v1.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "Specful MSRS profile v1 frontmatter",
  "type": "object",
  "required": ["type", "profile-version", "id", "title", "requirements"],
  "properties": {
    "type": { "const": "MSRS" },
    "profile-version": { "const": 1 },
    "id": { "$ref": "#/$defs/msrs-id" },
    "title": { "$ref": "#/$defs/title" },
    "governed-by": {
      "type": "array",
      "items": { "$ref": "#/$defs/adr-id" },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/requirement-id" },
      "additionalProperties": { "$ref": "#/$defs/requirement" }
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "msrs-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-MSRS-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "requirement-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-REQ-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "adr-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-ADR-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "artifact-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-(?:ADR|MSRS|MSDD)-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        { "not": { "pattern": "^\\s|\\s$" } }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "allOf": [
        { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        { "not": { "pattern": "^\\s|\\s$" } }
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "fragment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})+$"
    },
    "absolute-uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
      "not": {
        "anyOf": [
          { "pattern": "^[Ff][Ii][Ll][Ee]:" },
          { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*@" }
        ]
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "artifact-id"],
          "properties": {
            "type": { "const": "artifact" },
            "artifact-id": { "$ref": "#/$defs/artifact-id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "path" },
            "path": { "$ref": "#/$defs/path" },
            "fragment": { "$ref": "#/$defs/fragment" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "uri"],
          "properties": {
            "type": { "const": "uri" },
            "uri": { "$ref": "#/$defs/absolute-uri" },
            "locator": { "$ref": "#/$defs/title" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "description"],
          "properties": {
            "type": { "const": "citation" },
            "description": { "$ref": "#/$defs/description" }
          },
          "additionalProperties": false
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
      },
      "additionalProperties": false
    }
  }
}
