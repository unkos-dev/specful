{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unkos-dev.github.io/specful/schemas/requirement/v1.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "Specful Requirement profile v1 frontmatter",
  "type": "object",
  "required": ["type", "profile-version", "id", "title"],
  "properties": {
    "type": { "const": "REQ" },
    "profile-version": { "const": 1 },
    "id": { "$ref": "#/$defs/requirement-id" },
    "title": { "$ref": "#/$defs/title" },
    "governed-by": {
      "type": "array",
      "items": { "$ref": "#/$defs/adr-id" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "patternProperties": {
    "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": true
  },
  "additionalProperties": false,
  "$defs": {
    "requirement-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-REQ-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "adr-id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}-ADR-[0-9]{4}$",
      "not": { "pattern": "-0000$" }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "allOf": [
        { "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
        { "not": { "pattern": "^\\s|\\s$" } }
      ]
    }
  }
}
