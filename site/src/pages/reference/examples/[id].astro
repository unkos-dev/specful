---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { render } from 'astro:content';
import { getAdrExamples, slugFor } from '../../../lib/adr-examples';

export async function getStaticPaths() {
  const entries = await getAdrExamples();
  return entries.map((entry) => ({
    params: { id: slugFor(entry.data.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description: `Reference example: ${entry.data.id}, rendered from the repository's own docs/adr/.`,
  }}
>
  <p>
    This page is rendered at build time from <code>docs/adr/{entry.id}</code> in the Specful
    repository. It is not a separate copy: editing the source ADR and rebuilding the site is the
    only way to change this page.
  </p>
  <Content />
</StarlightPage>
